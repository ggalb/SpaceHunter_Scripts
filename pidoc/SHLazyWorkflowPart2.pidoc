\reference irsa_dust {
   NASA/IPAC Infrared Science Archive, \e {Galactic Dust Reddening and
   Extinction},
   \xref {https://irsa.ipac.caltech.edu/applications/DUST/} {https://irsa.ipac.caltech.edu/applications/DUST/};
   map by D. J. Schlegel, D. P. Finkbeiner and M. Davis (1998).
}

\reference autocolor {
   Hartmut V. Bornemann, \e {AutoColor},
   \xref {https://www.skypixels.at/pixinsight_scripts.html#autocolor} {https://www.skypixels.at/pixinsight_scripts.html}
}

\make
