<xri version="1.0">
   <description>
      <p>
         <b>Space Hunter Scripts for PixInsight</b>
      </p>
      <p>A collection of scripts for automated linear image processing of OSC camera images.</p>
      <p>Copyright © 2026 Georg G Albrecht. MIT License.</p>
      <p>Repository: https://github.com/ggalb/SpaceHunter_Scripts</p>
   </description>
   <!-- PixInsight 1.9.6:1.9.6 only (signed Part 1 depends on its ImageSolver). Packages for 1.9.5 and earlier are withdrawn. -->
   <platform os="all" arch="noarch" version="1.9.6:1.9.6">
      <package fileName="SpaceHunter_Scripts_20261118.zip" sha1="144d2250bd9e3c29c78e43d3b5f31ec43a82eb3d" type="script" releaseDate="20261118" title="Space Hunter Scripts 20261118">
         <description>
            <p>Changelog (requires PixInsight 1.9.6):</p>
            <p>Compliance with the Certified PixInsight Developer Program (CPDP) Rules, version 1.0.2.</p>
            <p>All scripts code-signed by a Certified PixInsight Developer (GeorgAlbrecht-SpaceHunter).</p>
            <p>Part 1 v2.7.32, Part 2 v2.4.27, new: Master v1.0.0; +Previews v2.2.7, NamePreviews v2.1.1, KillPreviews v2.0.2.</p>
            <p>New: SH Lazy Workflow Master runs Part 1 and Part 2 as one workflow; Part 2 continues by itself after Apply in Part 1&apos;s model / GC panel.</p>
            <p>Part 1: applying a background model or GC result is fast again on old stacks (no FITS HISTORY lines; the model is recorded in the property SpaceHunter:GradientModel).</p>
            <p>Part 2: MAS preview is fast on old stacks (FITS keywords no longer copied to the preview).</p>
            <p>Full changelog: https://github.com/ggalb/SpaceHunter_Scripts/blob/main/CHANGELOG.md</p>
         </description>
         <remove>
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_V8_v2.1.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part2_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part2_V8_v2.1.js,
            src/scripts/Space_Hunter/SH_+Preview_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_KillPreviews_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_NamePreviews_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_Legacy_v1.4.js,
            src/scripts/Space_Hunter/SH_Cog.png,
            src/scripts/Space_Hunter/SH_pdfIcon.png,
            src/scripts/Space_Hunter/SH_Workflow_Guide.pdf,
            src/scripts/Space_Hunter/SH_WorkFlow1.svg,
            src/scripts/Space_Hunter/SH_WorkFlow2.svg,
            src/scripts/Space_Hunter/SH_PlusPreviews.svg,
            src/scripts/Space_Hunter/SH_KillPreviews.svg,
            src/scripts/Space_Hunter/SH_NamePreviews.svg,
            src/scripts/Space_Hunter/SH_WarningSign.png
         </remove>
      </package>
   </platform>
