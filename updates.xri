<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">

   <description>
      <p><b>Space Hunter Scripts for PixInsight</b></p>
      <p>A collection of scripts for automated linear image processing of OSC camera images.</p>
      <p>Copyright &copy; 2026 Georg G Albrecht. MIT License.</p>
      <p>Repository: https://github.com/ggalb/SpaceHunter_Scripts</p>
   </description>

   <!-- PixInsight 1.9.6 and later. Packages for 1.9.5 and earlier are withdrawn. -->
   <platform os="all" arch="noarch" version="1.9.6:1.9.9">
      <package
         fileName="SpaceHunter_Scripts_20261103_1540.zip"
         sha1="b5aea00c176868debd7ca67ddd061d876b94ad98"
         type="script"
         releaseDate="20261103"
         title="Space Hunter Scripts 20261103_1540">
         <description>
            <p>Changelog (requires PixInsight 1.9.6):</p>
            <p>Part 1 v2.7.11, Part 2 v2.4.13, +Previews v2.2.7, NamePreviews v2.1.1, KillPreviews v2.0.2.</p>
            <p>Part 2 step 5 renamed Auto Display Stretch (linked/unlinked): it sets PixInsight's ScreenTransferFunction with the AutoSTF method and chooses linked or unlinked automatically.</p>
            <p>Part 1: the gradient model windows use the same Auto Display Stretch.</p>
            <p>Part 2: the downloaded dust map is checked value by value before use.</p>
            <p>Full changelog: https://github.com/ggalb/SpaceHunter_Scripts/blob/main/CHANGELOG.md</p>
         </description>
         <remove>
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_V8_v2.1.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part2_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part2_V8_v2.1.js,
            src/scripts/Space_Hunter/SH_+Preview_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_KillPreviews_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_NamePreviews_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_Legacy_v1.4.js,
            src/scripts/Space_Hunter/SH_Cog.png,
            src/scripts/Space_Hunter/SH_pdfIcon.png,
            src/scripts/Space_Hunter/SH_Workflow_Guide.pdf,
            src/scripts/Space_Hunter/SH_WorkFlow1.svg,
            src/scripts/Space_Hunter/SH_WorkFlow2.svg,
            src/scripts/Space_Hunter/SH_PlusPreviews.svg,
            src/scripts/Space_Hunter/SH_KillPreviews.svg,
            src/scripts/Space_Hunter/SH_NamePreviews.svg,
            src/scripts/Space_Hunter/SH_WarningSign.png
         </remove>
      </package>
   </platform>

</xri>
