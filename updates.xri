<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">

   <description>
      <p><b>Space Hunter Scripts for PixInsight</b></p>
      <p>A collection of scripts for automated linear image processing of OSC camera images.</p>
      <p>Copyright &copy; 2026 Georg G Albrecht. MIT License.</p>
      <p>Repository: https://github.com/ggalb/SpaceHunter_Scripts</p>
   </description>

   <!-- Legacy scripts for PixInsight 1.8.0 through 1.9.3 (SpiderMonkey engine) -->
   <platform os="all" arch="noarch" version="1.8.0:1.9.3">
      <package
         fileName="SpaceHunter_Scripts_20260329.zip"
         sha1="db83859a36628eb26f046482fb842cf93baa5b86"
         type="script"
         releaseDate="20260729"
         title="Space Hunter Scripts v1.4">
         <description>
            <p><b>Space Hunter Scripts v1.4</b></p>
            <p>- Per-step elapsed time in console output for SPFC, Create Previews, MGC, and GC.</p>
            <p>- Section title tooltips on GradientCorrection and DynamicBackgroundExtraction.</p>
            <p>- Updated workflow guide (PDF).</p>
            <p>Includes:</p>
            <p>- SH Lazy Workflow Part 1: Smart plate solving (ASTAP), ImageSolver, SPFC, variable previews, MultiscaleGradientCorrection, optional GradientCorrection and DynamicBackgroundExtraction.</p>
            <p>- SH Lazy Workflow Part 2: BlurXTerminator, Background finder with Exclusion Zones, SPCC, AutoColor, Adaptive Auto STF, StarXTerminator or StarNet2, NoiseXTerminator.</p>
            <p>- SH +Previews: Creates 1-6 full-size previews with preset or custom naming.</p>
            <p>- SH KillPreviews: Deletes all previews from the active image window.</p>
            <p>- SH NamePreviews: Renames previews to Exclude1, Exclude2, etc.</p>
         </description>
      </package>
   </platform>

   <!-- V8 scripts for PixInsight 1.9.4 only (frozen since the 20261013 release) -->
   <platform os="all" arch="noarch" version="1.9.4:1.9.4">
      <package
         fileName="SpaceHunter_Scripts_V8_v2.0.zip"
         sha1="2452bddffdc0f744be29819a23dc5a8ca7ff78c4"
         type="script"
         releaseDate="20260729"
         title="Space Hunter Scripts V8 v2.1">
         <description>
            <p><b>Space Hunter Scripts V8 v2.1</b></p>
            <p>- RC-Astro v1.1.2.2 support: ML Version selection and Tile Overlap controls for BXT and SXT.</p>
            <p>- NXT simplified — opens tool directly for manual configuration.</p>
            <p>- Per-step elapsed time in console output for key workflow steps.</p>
            <p>- Section title tooltips for BXT, SXT, GC, and DBE.</p>
            <p>- UI alignment improvements.</p>
            <p>- Legacy Part 1 (with ImageSolver) bundled for convenience.</p>
            <p>- Updated workflow guide (PDF).</p>
            <p>- Requires PixInsight 1.9.4 or later.</p>
            <p>NOTE: If you received the earlier v2.1 update and see duplicate scripts in your Space_Hunter menu, delete the files ending in _V8_v2.1.js from your Space_Hunter folder, then re-add the scripts via Feature Scripts.</p>
            <p>Includes:</p>
            <p>- SH Lazy Workflow Part 1 V8: Smart plate solving (ASTAP), SPFC, variable previews, MultiscaleGradientCorrection, optional GradientCorrection and DynamicBackgroundExtraction.</p>
            <p>- SH Lazy Workflow Part 1 (Legacy+ImageSolver): For users who need ImageSolver integrated in the script.</p>
            <p>- SH Lazy Workflow Part 2 V8: BlurXTerminator, Background finder with Exclusion Zones, SPCC, AutoColor, Adaptive Auto STF, StarXTerminator or StarNet2, NoiseXTerminator.</p>
            <p>- SH +Previews: Creates 1-6 full-size previews with preset or custom naming.</p>
            <p>- SH KillPreviews: Deletes all previews from the active image window.</p>
            <p>- SH NamePreviews: Renames previews to Exclude1, Exclude2, etc.</p>
         </description>
      </package>
   </platform>

   <!-- V8 scripts for PixInsight 1.9.5+ : one dated zip per release, fixed script file names -->
   <platform os="all" arch="noarch" version="1.9.5:1.9.9">
      <package
         fileName="SpaceHunter_Scripts_20261013.zip"
         sha1="ecef5b94c0bcbab1d54fa7c799fc057e0306d146"
         type="script"
         releaseDate="20261013"
         title="Space Hunter Scripts 20261013">
         <description>
            <p><b>Space Hunter Scripts, October 2026</b> (requires PixInsight 1.9.5)</p>
            <p>Part 1 v2.5.2, Part 2 v2.3.2, +Previews v2.2.1, NamePreviews v2.1, KillPreviews v2.0.</p>
            <p>- Script file names no longer carry a version number. Old versioned files, the Legacy Part 1 and the PDF guide are removed automatically. Your saved settings are kept.</p>
            <p>- Manuals in PixInsight's documentation format, opened from the documentation button in each dialog.</p>
            <p>- Part 1: automatic plate solving with PixInsight's ImageSolver (ASTAP only as fallback), optional Ha/OIII separation for dual-band OSC images, separate SPFC filter dropdowns, instant background-model apply, GradientCorrection result chooser.</p>
            <p>- Part 2: new tiled background finder (Exclude previews optional), pre-check with optional IRSA dust map, SPCC background-reference fix, Adaptive Auto STF with automatic linked/unlinked, MLDenoise as alternative to NoiseXTerminator, separate ML Version and Tile Overlap for BXT Correct Only and BXT Full.</p>
            <p>- Re-run protection in Part 1 and Part 2.</p>
            <p>- +Previews: New Instance support; repeated names get _1, _2, ...  NamePreviews: re-running no longer produces names like Exclude11.</p>
            <p>Full changelog: https://github.com/ggalb/SpaceHunter_Scripts</p>
         </description>
         <remove>
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_V8_v2.1.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part2_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part2_V8_v2.1.js,
            src/scripts/Space_Hunter/SH_+Preview_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_KillPreviews_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_NamePreviews_V8_v2.0.js,
            src/scripts/Space_Hunter/SH_LazyWorkflow_Part1_Legacy_v1.4.js,
            src/scripts/Space_Hunter/SH_Cog.png,
            src/scripts/Space_Hunter/SH_pdfIcon.png,
            src/scripts/Space_Hunter/SH_Workflow_Guide.pdf
         </remove>
      </package>
   </platform>

</xri>
